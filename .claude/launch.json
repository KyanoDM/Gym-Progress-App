{"version":"0.0.1","configurations":[{"name":"static-site","runtimeExecutable":"node","runtimeArgs":["-e","const fs=require('fs');require('http').createServer((q,r)=>{let f='.'+decodeURIComponent(q.url.split('?')[0]);fs.readFile(f,(e,d)=>{if(e){r.statusCode=404;r.end()}else{r.setHeader('Content-Type',f.endsWith('.css')?'text/css':f.endsWith('.png')?'image/png':'text/html');r.end(d)}})}).listen(5599)"],"port":5599}]}
